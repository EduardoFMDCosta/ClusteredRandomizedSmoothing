Bootstrap: docker
From: python:3.11-slim

%labels
    Author RandomizedSmoothing
    Description Apptainer image for RandomizedSmoothing

%environment
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export PIP_NO_CACHE_DIR=1
    export PATH=/usr/local/bin:$PATH

%files
    $PWD/requirements.txt requirements.txt
    $PWD/pyproject.toml pyproject.toml
    $PWD/README.md README.md
    $PWD/src src
    $PWD/experiments experiments

%post
    set -e
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        libgl1 \
        libglib2.0-0
    rm -rf /var/lib/apt/lists/*

    python3 -m pip install --upgrade pip setuptools wheel

    grep -Ev '^(torch|torch_geometric|torch_scatter)==' requirements.txt > /tmp/requirements-nontorch.txt
    python3 -m pip install -r /tmp/requirements-nontorch.txt

    python3 -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.4.0
    python3 -m pip install --no-cache-dir --no-deps torch_geometric==2.5.3
    python3 -m pip install --no-cache-dir --force-reinstall --no-deps \
        torch_scatter==2.1.2+pt24cpu \
        -f https://data.pyg.org/whl/torch-2.4.0+cpu.html

    python3 -m pip install -e . --no-deps

%runscript
    exec /bin/bash "$@"

